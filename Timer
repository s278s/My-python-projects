from time import sleep
from os import system

while True:
    x = input('Timer app\n1)start timer\t2)stopwatch\t  3)exit timer\n')
    if x == '1':
        h = int(input("Enter hours:"))
        m = int(input("Enter minutes:"))
        sec = int(input("Enter seconds:"))
        total = h * 3600 + m * 60 + sec
        t = total
        for i in range(3,0,-1):
            print(i,end='..' if i > 1 else '\n')
            sleep(1)
        while total >= 1:
            print(total,end='\t\ttime = ')
            print(f'{t}s')
            sleep(1)
            total -= 1
            system('clear')
    elif x == '2':
        h = int(input("Enter hours:"))
        m = int(input("Enter minutes:"))
        sec = int(input("Enter seconds:"))
        total = h * 3600 + m * 60 + sec
        for i in range(3,0,-1):
            print(i,end = '..' if i > 1 else '\n')
            sleep(1)
        i = 0
        while i < total:
            print(f'{i + 1}s',end = f'\t\t\t\t{h}h {m}min {sec}sec\n')
            sleep(1)
            system('clear')
            i += 1
    elif x == '3':
        print('Exiting',end = '')
        sleep(0.25)
        for i in range(3):
            print('.',end='')
            sleep(0.25)
        break
